{
  "$id": "zh-annotations/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "readingId": {
      "type": "string",
      "minLength": 1
    },
    "perCharacter": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "char": {
            "type": "string",
            "minLength": 1
          },
          "citationPinyinChar": {
            "type": "string",
            "minLength": 1
          },
          "compositionalBoundFlag": {
            "type": "boolean"
          }
        },
        "required": [
          "char",
          "citationPinyinChar",
          "compositionalBoundFlag"
        ],
        "additionalProperties": false
      }
    },
    "citationPinyin": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "surfacePinyin": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "toneTrack": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "neutralToneSlots": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "erhuaSlots": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "pos": {
      "type": "string",
      "minLength": 1
    },
    "senseId": {
      "type": "string",
      "minLength": 1
    },
    "gloss": {
      "type": "string",
      "minLength": 1
    },
    "contextKey": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "boundMorpheme": {
      "type": "boolean"
    },
    "spanGroupId": {
      "type": "string",
      "minLength": 1
    },
    "redReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "perCharacter",
    "citationPinyin",
    "surfacePinyin",
    "toneTrack",
    "neutralToneSlots",
    "erhuaSlots",
    "boundMorpheme"
  ],
  "additionalProperties": false
}
