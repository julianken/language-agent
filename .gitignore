# Dependencies
node_modules/

# Next.js
.next/
out/
build/

# TypeScript package build output (tsc -p <pkg>/tsconfig.build.json)
dist/
*.tsbuildinfo

# Python (the sidecars are Python; envs and caches never belong in git)
__pycache__/
.venv/
.pytest_cache/
.schemathesis/

# g2pw (issue #20 curation toolchain) auto-downloads its ONNX model into
# the process's CWD on first run — when run from repo root (e.g. via the
# curation container's documented `docker run -v "$PWD":/repo -w /repo`
# invocation) that lands a ~600 MB model dir at the repo root. Never commit.
/G2PWModel/

# Misc
.DS_Store
*.log
.env*.local

# Process artifacts / scratch (analysis, funnel, scratch output) — never the curated repo
tmp/

# Session tooling (not part of the app)
.remember/
.superpowers/
.playwright-mcp/

# Claude Code: repo-local agents/skills ARE committed; per-developer settings and agent worktrees are not
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Cursor: commit shared config (rules/agents/commands) if ever added; ignore per-developer state.
# Do NOT blanket-ignore .cursor/ — that would hide a future committed pointer/config.
.cursor/mcp.json

# per-instance fill input (values are public, but keep the build input out of git)
.seed/answers.json

# Vite site build + Playwright artifacts (issue #10 e2e; screenshots are
# NEVER committed — PR images go through the user-attachments paste flow)
dist-site/
test-results/
playwright-report/
.vite/
